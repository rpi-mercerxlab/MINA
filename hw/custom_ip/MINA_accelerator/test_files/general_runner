#!/usr/bin/env bash
set -e

if [ -z "$1" ]; then
    echo "Usage: ./run_tb.sh <tb_entity_name_or_file> [wave_file.ghw]"
    exit 1
fi

# Strip .vhd extension if the user tab-completed the filename
TB_ENTITY="${1%.vhd}"
TB_FILE="${TB_ENTITY}.vhd"
WAVE_FILE="${2:-npu.ghw}"

# Read non-empty, non-comment lines from rtl_sources.txt into a Bash array
mapfile -t RTL_SRCS < <(grep -vE '^\s*(#|$)' rtl_sources.txt)

echo "==> Analyzing RTL sources and ${TB_FILE}..."
ghdl -a --std=08 -frelaxed-rules "${RTL_SRCS[@]}" "${TB_FILE}"

echo "==> Elaborating ${TB_ENTITY}..."
ghdl -e --std=08 -frelaxed-rules "${TB_ENTITY}"

echo "==> Running ${TB_ENTITY} (Waveform: ${WAVE_FILE})..."
ghdl -r --std=08 -frelaxed-rules "${TB_ENTITY}" \
    --assert-level=error --wave="${WAVE_FILE}"
